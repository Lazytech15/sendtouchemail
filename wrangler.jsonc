{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendtouchemail",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },

  "workflows": [
    {
      "name": "email-workflow",
      "binding": "EMAIL_WORKFLOW",
      "class_name": "EmailWorkflow"
    }
  ],

  /**
   * Migrations
   * v1: created WorkflowStatusDO (original demo)
   * v2: delete it so Cloudflare allows removing the class from the worker
   */
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowStatusDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["WorkflowStatusDO"]
    }
  ],

  "upload_source_maps": true

  /**
   * Secrets — set via CLI, never commit values:
   *   npx wrangler secret put RESEND_API_KEY
   *   npx wrangler secret put TO_EMAIL
   */
}
