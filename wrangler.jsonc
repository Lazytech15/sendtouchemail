{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendtouchemail",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },

  /**
   * Workflows
   * EmailWorkflow handles sending via Resend after a contact form submission
   */
  "workflows": [
    {
      "name": "email-workflow",
      "binding": "EMAIL_WORKFLOW",
      "class_name": "EmailWorkflow"
    }
  ],

  "upload_source_maps": true

  /**
   * Secrets (do NOT put real values here)
   * Set them with:
   *   npx wrangler secret put RESEND_API_KEY
   *   npx wrangler secret put TO_EMAIL
   */
}
